# Server
HOST=0.0.0.0
PORT=1337
PUBLIC_URL=                      # the CMS's own public origin; used in admin links

# Secrets — generate per environment, never reuse across boxes
APP_KEYS=                        # 4 comma-separated base64 values
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
JWT_SECRET=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=

# Database — SQLite. In a container, .tmp/ must be a mounted volume or data is lost.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# CORS — explicit origins, comma separated. Never '*'.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Production behind Nginx: trust X-Forwarded-* headers.
IS_PROXIED=false

# After any content change, POST here so the site drops its cached pages (src/index.ts).
# The frontend's /api/revalidate, and the same secret as its REVALIDATE_SECRET. Leave
# empty locally when no frontend is running. In the prod stack: http://frontend:3000/api/revalidate
REVALIDATE_URL=
REVALIDATE_SECRET=
